# Base nueva (v2): mismas credenciales de Neon, esquema "app".
# DATABASE_URL usa el pooler (host con "-pooler"); DIRECT_URL la conexión directa para migraciones.
DATABASE_URL="postgresql://<usuario>:<clave>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&schema=app"
DIRECT_URL="postgresql://<usuario>:<clave>@<host>.<region>.aws.neon.tech/neondb?sslmode=require&schema=app"

# Base del sistema anterior (solo lectura, para importar clientes y cotizaciones).
# Normalmente es la misma base, esquema "public".
LEGACY_DATABASE_URL="postgresql://<usuario>:<clave>@<host>.<region>.aws.neon.tech/neondb?sslmode=require"
