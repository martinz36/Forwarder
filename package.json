{
  "name": "forwarder",
  "version": "2.0.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "env:setup": "tsx scripts/setup-env.ts",
    "legacy:import": "tsx scripts/import-legacy.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/pricing/*.test.ts scripts/legacy/*.test.ts",
    "invite:create": "tsx scripts/create-invitation.ts",
    "dev:user": "tsx scripts/dev-seed-user.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.5",
    "next": "16.3.8",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
