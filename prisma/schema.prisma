generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OperationStatus {
  EN_TRANSITO
  EN_ADUANA
  RETIRADO
  LIQUIDADO
}

enum CustomsChannel {
  VERDE
  NARANJA
  ROJO
}

enum DocumentType {
  BL
  FACTURA_COMERCIAL
  PACKING_LIST
  DAM
  LIQUIDACION
  OTRO
}

enum LiquidationStatus {
  DRAFT
  FINAL
  BILLED
}

model Client {
  id             String       @id @default(cuid())
  documentType   String       @default("RUC")
  documentNumber String       @unique
  businessName   String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quotations     Quotation[]
  notes          ClientNote[]
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdBy String?  @default("BROKER")
  createdAt DateTime @default(now())
}

model Quotation {
  id          String          @id @default(cuid())
  code        String          @unique
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  totalUsd    Float           @default(0)
  totalPen    Float           @default(0)
  profitUsd   Float           @default(0)
  profitPen   Float           @default(0)
  items       QuotationItem[]
  operation   Operation?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  currency    String    @default("USD")
  unitCost    Float     @default(0)
  unitPrice   Float
  quantity    Int
  total       Float
  isTaxable   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ConceptCatalog {
  id              String   @id @default(cuid())
  name            String   @unique
  defaultCurrency String   @default("USD")
  defaultPrice    Float?
  isTaxable       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Operation {
  id             String          @id @default(cuid())
  quotationId    String          @unique
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status         OperationStatus @default(EN_TRANSITO)
  blNumber       String?
  etd            DateTime?
  eta            DateTime?
  customsChannel CustomsChannel?
  sharedToken    String          @unique @default(uuid())
  charges        OperationCharge[]
  documents      Document[]
  liquidation    Liquidation?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OperationCharge {
  id            String    @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  description   String
  currency      String    @default("USD")
  unitCost      Float
  unitPrice     Float
  quantity      Int
  totalCost     Float
  totalPrice    Float
  isExtraCharge Boolean   @default(false)
  isTaxable     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Document {
  id           String       @id @default(cuid())
  operationId  String
  operation    Operation    @relation(fields: [operationId], references: [id], onDelete: Cascade)
  name         String
  fileUrl      String
  documentType DocumentType @default(OTRO)
  uploadedBy   String       @default("BROKER")
  uploadedAt   DateTime     @default(now())
}

model Liquidation {
  id                 String            @id @default(cuid())
  operationId        String            @unique
  operation          Operation         @relation(fields: [operationId], references: [id], onDelete: Cascade)
  status             LiquidationStatus @default(DRAFT)
  subtotalTaxableUsd Float             @default(0)
  igvUsd             Float             @default(0)
  totalTaxableUsd    Float             @default(0)
  totalNonTaxableUsd Float             @default(0)
  grandTotalUsd      Float             @default(0)

  subtotalTaxablePen Float             @default(0)
  igvPen             Float             @default(0)
  totalTaxablePen    Float             @default(0)
  totalNonTaxablePen Float             @default(0)
  grandTotalPen      Float             @default(0)

  invoiceNumber      String?
  sunatPdfUrl        String?
  sunatCdrStatus     String?           @default("PENDING")
  sunatNotes          String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}
